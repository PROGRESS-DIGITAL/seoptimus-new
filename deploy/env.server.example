# Скопируйте в .env в корне проекта на сервере: cp deploy/env.server.example .env
# Домен тестового стенда (A-запись должна смотреть на IP сервера). Пусто = доступ по http://IP
DOMAIN=
# Пароль Postgres (сгенерировать: openssl rand -hex 24)
POSTGRES_PASSWORD=

# Секрет сессий (сгенерировать: openssl rand -hex 32)
SESSION_SECRET=
# Полный адрес стенда: https://test.seoptimus.ru или http://IP
APP_URL=
ADMIN_EMAILS=

# Без ключа — демо-режим (заглушка вместо нейросети)
OPENAI_API_KEY=
# Сервер в РФ: OpenAI напрямую недоступен, нужен прокси/шлюз
OPENAI_BASE_URL=

CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_API_SECRET=

# Без SMTP код входа печатается в лог: docker compose logs app | grep -i код
SMTP_URL=
MAIL_FROM=SEOPTIMUS <no-reply@seoptimus.ru>

GUEST_DAILY_LIMIT=3
USD_RUB=100
MIN_MARKUP=10
