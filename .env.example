# База данных PostgreSQL
DATABASE_URL=postgres://app:app@localhost:5432/seoptimus
# Секрет для подписи сессий (любая длинная случайная строка)
SESSION_SECRET=change-me-to-a-long-random-string
# Адрес сайта (для ссылок в письмах и вебхуков)
APP_URL=http://localhost:3000
# Email-адреса администраторов через запятую
ADMIN_EMAILS=admin@example.com

# OpenAI. Без ключа приложение работает в демо-режиме с заглушкой вместо нейросети.
OPENAI_API_KEY=
# Необязательно: адрес прокси/шлюза OpenAI (если сервер в РФ)
OPENAI_BASE_URL=

# CloudPayments
CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_API_SECRET=

# Почта для кодов входа. Без SMTP код печатается в лог сервера.
SMTP_URL=
MAIL_FROM=SEOPTIMUS <no-reply@seoptimus.ru>

# Бесплатные генерации без регистрации в сутки
GUEST_DAILY_LIMIT=3

# Экономика: курс доллара и минимальная наценка на затраты на нейросети (10 = 10 к 1)
USD_RUB=100
MIN_MARKUP=10
